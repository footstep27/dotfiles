# Everything this setup requires. Installed by bootstrap.sh and checked by verify.sh.

brew "chezmoi"
brew "age"
brew "tmux"

# CLI tools the shell config depends on
brew "btop"
brew "eza"
brew "bat"
brew "git-delta"
brew "lazygit"
brew "yazi"

# Sourced unconditionally by .zshrc; without them every shell prints errors
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Terminal
cask "ghostty"

# Text face and icon set in one font: covers Nerd Font glyphs, nothing manual
cask "font-maple-mono-nf"

# Agent CLI; .config/opencode is managed below
brew "opencode"
