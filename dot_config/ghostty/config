# Ghostty configuration
# Managed by chezmoi — edit the copy in the dotfiles repo, not this file.
# Verify with: scripts/verify.sh

# ---------- Appearance ----------
# Follows macOS appearance: light mode gets Latte, dark gets Mocha.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
background-opacity = 0.96
background-blur = 20
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
unfocused-split-opacity = 0.75
cursor-style = block
cursor-style-blink = false

# ---------- Typography ----------
# MonoLisa renders text; the symbols-only Nerd Font fills powerline separators
# and file icons used by the prompt and `eza --icons`. MonoLisa is licensed and
# cannot be redistributed — see docs/fonts.md.
font-family = MonoLisa
font-family = Symbols Nerd Font Mono
font-size = 14

# ---------- Behaviour ----------
scrollback-limit-lines = 10000
copy-on-select = clipboard
confirm-close-surface = true
mouse-hide-while-typing = true
# tmux owns persistence; restoring stale windows fights it.
window-save-state = never
auto-update-channel = stable
macos-non-native-fullscreen = false

# ---------- Shell integration ----------
shell-integration = zsh
shell-integration-features = cursor,sudo,title,path

# ---------- Keyboard ----------
# macOS German layout types @, {, }, [, ], |, \, ~ and € with Option. Turning
# Option into a Meta key would make those characters unreachable from the
# terminal. Word movement lives on Ctrl+Arrow instead (bound in .zshrc).
macos-option-as-alt = false

# Tabs
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+equal=equalize_splits

# Split navigation on Cmd+Ctrl+Arrows.
# Deliberately NOT the defaults (Cmd+Option+Arrows, Cmd+[ / Cmd+]): brackets are
# Option+5/6 on a German layout, and bare Ctrl+Arrow belongs to the shell.
keybind = super+ctrl+arrow_left=goto_split:left
keybind = super+ctrl+arrow_right=goto_split:right
keybind = super+ctrl+arrow_up=goto_split:up
keybind = super+ctrl+arrow_down=goto_split:down

# ---------- Quick terminal ----------
# Drops over any app and hides again on the same chord; never disturbs the
# main window's tabs.
keybind = global:super+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# ---------- Notifications ----------
# Only for slow commands, only when the window is not focused. The default
# action is a bell rather than a notification, so it is set explicitly.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
notify-on-command-finish-action = no-bell,notify
