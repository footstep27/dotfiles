# OpenCode secrets and machine-local state never belong in git.
# These are target paths, so they guard against a future `chezmoi add --recursive`.
.config/opencode/service.json
.config/opencode/package.json
.config/opencode/package-lock.json
.config/opencode/node_modules/
.config/opencode/.gitignore
.local/share/opencode/
.local/state/opencode/

# yazi packages are declared in package.toml and restored with `ya pkg install`;
# their trees must not drift into the source via `chezmoi add --recursive`.
# The one exception is my-commands: a small personal plugin with no upstream, so
# it has to be managed here to exist on a fresh machine.
.config/yazi/plugins/*
!.config/yazi/plugins/my-commands.yazi/
.config/yazi/flavors/
